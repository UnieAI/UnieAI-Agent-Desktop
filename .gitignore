# Release tarballs. `release:pack` writes 240 of them here; they are build
# output the registry already holds, and 256 of them reached this repository's
# history once because a wide `git add` did not know that.
dist/
python/sdk-runtime/src/deepseek_harness_runtime/runtime/dsh-jsonrpc-agent-*
python/sdk-runtime/src/deepseek_harness_runtime/runtime/node/
python/**/__pycache__/
python/**/.pytest_cache/
apps/web/dist/
.artifacts/
.dsh-build/
.playwright-mcp/
.orig
.worktrees/
worktrees/
.agents/worktrees/
.typert-*/

# The carried browser's payload: ~390MB per platform, downloaded by
# native/chromium/scripts/fetch-chromium.mjs and republished as the four
# per-platform npm packages. The pin (chromium-version.json) is tracked; the
# browser it names is not.
native/chromium/packages/*/browser/
native/chromium/packages/*/chromium.json
native/chromium/packages/*/LICENSE

# Electron packaging output: an unpacked app plus its installers, hundreds of
# megabytes rebuilt by `pnpm --filter @unieai/uad-desktop run package:*`.
apps/desktop/release/

# A browser profile directory literally named `[object Object]`: what a
# launcher writes when an options OBJECT reaches an argument builder that
# expects a path string. It has been committed once by a sweeping `git add`.
'[object Object]'/
