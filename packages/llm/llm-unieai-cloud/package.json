{
  "name": "@unieai/uad-llm-unieai-cloud",
  "description": "Registers the UnieAI account's entitled models as a runnable LLM route through the web product's metered inference relay",
  "version": "0.1.20",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/llm/llm-unieai-cloud"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-llm": "workspace:^",
    "@unieai/uad-llm-pi-ai": "workspace:^",
    "@unieai/uad-timeout": "workspace:^",
    "@unieai/uad-unieai-web-gate": "workspace:^",
    "@unieai/schemastery": "workspace:^",
    "@unieai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-llm": "workspace:^",
    "@unieai/uad-llm-pi-ai": "workspace:^",
    "@unieai/uad-timeout": "workspace:^",
    "@unieai/uad-unieai-web-gate": "workspace:^",
    "@unieai/schemastery": "workspace:^",
    "@unieai/cordis": "workspace:^"
  }
}
