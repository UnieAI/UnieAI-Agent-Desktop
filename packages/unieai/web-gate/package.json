{
  "name": "@unieai/uad-unieai-web-gate",
  "description": "Browser sign-in gate: the /auth routes, the server-rendered sign-in page, and the WebServer request guard behind them",
  "version": "0.1.19",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/unieai/web-gate"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@unieai/uad-host-webserver": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/schemastery": "workspace:^",
    "@unieai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@unieai/uad-host-webserver": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/schemastery": "workspace:^",
    "@unieai/cordis": "workspace:^"
  }
}
