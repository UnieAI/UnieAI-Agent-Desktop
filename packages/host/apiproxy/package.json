{
  "name": "@unieai/uad-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@unieai/uad-attachment": "workspace:^",
    "@unieai/uad-agent": "workspace:^",
    "@unieai/uad-agent-default-model": "workspace:^",
    "@unieai/uad-api-remotes": "workspace:^",
    "@unieai/uad-brand": "workspace:^",
    "@unieai/uad-commands": "workspace:^",
    "@unieai/uad-credentials": "workspace:^",
    "@unieai/uad-goal": "workspace:^",
    "@unieai/uad-host-directory-picker": "workspace:^",
    "@unieai/uad-llm": "workspace:^",
    "@unieai/uad-native-command": "workspace:^",
    "@unieai/uad-session": "workspace:^",
    "@unieai/uad-session-persistence": "workspace:^",
    "@unieai/uad-session-projection": "workspace:^",
    "@unieai/uad-session-projection-cache": "workspace:^",
    "@unieai/uad-session-query": "workspace:^",
    "@unieai/uad-session-title": "workspace:^",
    "@unieai/uad-settings": "workspace:^",
    "@unieai/uad-skill": "workspace:^",
    "@unieai/uad-subagent": "workspace:^",
    "@unieai/uad-jobs": "workspace:^",
    "@unieai/uad-tools": "workspace:^",
    "@unieai/uad-user-approval": "workspace:^",
    "@unieai/uad-user-questions": "workspace:^",
    "@unieai/uad-workspace": "workspace:^",
    "@unieai/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-agent-presets": "workspace:^",
    "@unieai/uad-browser-operator": "workspace:^",
    "@unieai/uad-cordis-host-runner": "workspace:^",
    "@unieai/uad-fs": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-terminal-operator": "workspace:^"
  },
  "devDependencies": {
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-agent-presets": "workspace:^",
    "@unieai/uad-browser-operator": "workspace:^",
    "@unieai/uad-cordis-host-runner": "workspace:^",
    "@unieai/uad-fs": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-storage": "workspace:^",
    "@unieai/uad-storage-domain": "workspace:^",
    "@unieai/uad-terminal-operator": "workspace:^",
    "@unieai/uad-typert-protocol": "workspace:^",
    "@unieai/uad-typert-registry": "workspace:^"
  }
}
