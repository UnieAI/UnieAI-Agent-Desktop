{
  "name": "@unieai/uad-mcp-servers",
  "description": "MCP servers a person adds themselves: a settings-backed list, mounted live",
  "version": "0.1.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/mcp/mcp-servers"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-mcp-client": "workspace:^",
    "@unieai/uad-timeout": "workspace:^",
    "@unieai/schemastery": "workspace:^",
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-settings": "workspace:^"
  },
  "devDependencies": {
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-mcp-client": "workspace:^",
    "@unieai/uad-system-prompt": "workspace:^",
    "@unieai/uad-timeout": "workspace:^",
    "@unieai/uad-tools": "workspace:^",
    "@unieai/schemastery": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@unieai/uad-settings": "workspace:^"
  }
}
