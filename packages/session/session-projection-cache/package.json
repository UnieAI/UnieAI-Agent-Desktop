{
  "name": "@unieai/uad-session-projection-cache",
  "description": "Persisted projection cache (ctx.sessionProjectionCache): durable per-session projection checkpoints over the domain data form, throttled write-behind, and the cold-read ladder (cache row + persistence tail replay)",
  "version": "0.1.19",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/session/session-projection-cache"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@unieai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-session": "workspace:^",
    "@unieai/uad-session-persistence": "workspace:^",
    "@unieai/uad-session-projection": "workspace:^",
    "@unieai/uad-storage-domain": "workspace:^",
    "@unieai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-session": "workspace:^",
    "@unieai/uad-session-persistence": "workspace:^",
    "@unieai/uad-session-projection": "workspace:^",
    "@unieai/uad-storage": "workspace:^",
    "@unieai/uad-storage-domain": "workspace:^",
    "@unieai/cordis": "workspace:^"
  }
}
