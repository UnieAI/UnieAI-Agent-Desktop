{
  "name": "@unieai/uad-client-hmr",
  "description": "Dev-only hot-reload driver for script-loaded client entries: SSE rebuilt frames → invalidate/prefetch → fiber swap through the vendored Loader entry",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/client/hmr"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@unieai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@unieai/cordis-plugin-loader": "workspace:^",
    "@unieai/uad-client-modules": "workspace:^",
    "@unieai/uad-host-webserver": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@unieai/cordis-plugin-loader": "workspace:^",
    "@unieai/uad-client-modules": "workspace:^",
    "@unieai/uad-host-webserver": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/cordis": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
