{
  "name": "@unieai/uad-client-ui-unieai-providers",
  "description": "UnieAI API Provider settings section: the account's cloud providers, mirrored from the web product and added back to it",
  "version": "0.1.11",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/client/ui-unieai-providers"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@unieai/uad-client-runtime",
        "@unieai/uad-client-ui-settings",
        "@unieai/uad-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-client-locale": "workspace:^",
    "@unieai/uad-client-runtime": "workspace:^",
    "@unieai/uad-client-ui-settings": "workspace:^",
    "@unieai/uad-invariants": "workspace:^"
  },
  "devDependencies": {
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-client-locale": "workspace:^",
    "@unieai/uad-client-runtime": "workspace:^",
    "@unieai/uad-client-test-runtime": "workspace:^",
    "@unieai/uad-client-ui-primitives": "workspace:^",
    "@unieai/uad-client-ui-settings": "workspace:^",
    "@unieai/uad-client-ui-slots": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
