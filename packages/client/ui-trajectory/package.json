{
  "name": "@unieai/uad-client-ui-trajectory",
  "description": "Trajectory event ledger with an interactive timing overview: pure-consumer plugin registering into the conversation ViewMap (no service)",
  "version": "0.1.18",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/client/ui-trajectory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@unieai/uad-client-locale",
        "@unieai/uad-client-runtime",
        "@unieai/uad-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@unieai/uad-agent": "workspace:^",
    "@unieai/uad-client-locale": "workspace:^",
    "@unieai/uad-client-runtime": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-compaction": "workspace:^",
    "@unieai/uad-tools": "workspace:^",
    "@unieai/uad-client-ui-conversation": "workspace:^"
  },
  "devDependencies": {
    "@unieai/uad-agent": "workspace:^",
    "@unieai/uad-client-locale": "workspace:^",
    "@unieai/uad-client-runtime": "workspace:^",
    "@unieai/uad-client-test-runtime": "workspace:^",
    "@unieai/uad-client-ui-primitives": "workspace:^",
    "@unieai/uad-client-ui-conversation": "workspace:^",
    "@unieai/uad-client-ui-slots": "workspace:^",
    "@unieai/uad-compaction": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-tools": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@unieai/cordis": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
