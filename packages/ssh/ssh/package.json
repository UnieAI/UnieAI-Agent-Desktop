{
  "name": "@unieai/uad-ssh",
  "description": "The machines a person can already reach, and one multiplexed connection to each",
  "version": "0.1.17",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/ssh/ssh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/cordis": "workspace:^"
  },
  "dependencies": {
    "@unieai/uad-home-paths": "workspace:^",
    "@unieai/uad-subprocess": "workspace:^",
    "@unieai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-ssh-server": "workspace:^"
  },
  "scripts": {}
}
