{
  "name": "@unieai/uad-remote-machine",
  "description": "The dsh remote-machine bundle: the execution world on a machine reached over SSH",
  "version": "0.1.18",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/bundle/remote-machine"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/cordis": "workspace:^"
  },
  "dependencies": {
    "@unieai/uad-bash-local": "workspace:^",
    "@unieai/uad-fs-ssh": "workspace:^",
    "@unieai/uad-ssh": "workspace:^",
    "@unieai/uad-subprocess-ssh": "workspace:^"
  },
  "devDependencies": {
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-loader-smoke": "workspace:^"
  }
}
