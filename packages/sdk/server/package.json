{
  "name": "@unieai/uad-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process DeepSeek Harness SDK clients",
  "version": "0.1.17",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@unieai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@unieai/uad-agent": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-llm": "workspace:^",
    "@unieai/uad-llm-deepseek": "workspace:^",
    "@unieai/uad-scope": "workspace:^",
    "@unieai/uad-sdk-protocol": "workspace:^",
    "@unieai/uad-session": "workspace:^",
    "@unieai/uad-subagent": "workspace:^",
    "@unieai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@unieai/cordis-plugin-loader": "workspace:^",
    "@unieai/uad-agent": "workspace:^",
    "@unieai/uad-agent-spine-demo": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-llm": "workspace:^",
    "@unieai/uad-llm-deepseek": "workspace:^",
    "@unieai/uad-scope": "workspace:^",
    "@unieai/uad-sdk-protocol": "workspace:^",
    "@unieai/uad-session": "workspace:^",
    "@unieai/uad-session-persistence-jsonl": "workspace:^",
    "@unieai/uad-subagent": "workspace:^",
    "@unieai/cordis": "workspace:^"
  }
}
