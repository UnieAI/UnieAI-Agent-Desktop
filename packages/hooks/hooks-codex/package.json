    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-llm": "workspace:^",
    "@unieai/uad-session": "workspace:^",
    "@unieai/uad-session-persistence": "workspace:^",
    "@unieai/uad-tools": "workspace:^",
    "@unieai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@unieai/uad-agent": "workspace:^",
    "@unieai/uad-agent-loop": "workspace:^",
    "@unieai/uad-agent-loop-testkit": "workspace:^",
    "@unieai/uad-shell": "workspace:^",
    "@unieai/uad-bash-local": "workspace:^",
    "@unieai/uad-subprocess-local": "workspace:^",
    "@unieai/uad-hook-protocol": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-llm": "workspace:^",
    "@unieai/uad-session": "workspace:^",
    "@unieai/uad-session-persistence": "workspace:^",
    "@unieai/uad-session-persistence-jsonl": "workspace:^",
    "@unieai/uad-tools": "workspace:^",
    "@unieai/cordis": "workspace:^"
  }
