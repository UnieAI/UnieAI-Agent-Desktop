{
  "name": "@unieai/uad-browser-operator",
  "description": "The browser a person drives: a real Chromium on the host, streamed into the panel over the DevTools Protocol",
  "version": "0.1.12",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/browser/browser-operator"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./chromium": {
      "types": "./lib/types/chromium.d.ts",
      "default": "./lib/chromium.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/chromium.js",
    "lib/probe-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-invariants": "workspace:^"
  },
  "dependencies": {
    "@unieai/schemastery": "workspace:^",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-invariants": "workspace:^"
  },
  "optionalDependencies": {
    "@unieai/rabi-chromium-darwin-arm64": "workspace:^",
    "@unieai/rabi-chromium-darwin-x64": "workspace:^",
    "@unieai/rabi-chromium-linux-x64": "workspace:^",
    "@unieai/rabi-chromium-win32-x64": "workspace:^"
  }
}
