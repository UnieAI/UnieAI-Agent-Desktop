{
  "name": "@unieai/uad-machine-metrics",
  "description": "What a machine is doing right now: processor, memory, disk, and accelerators",
  "version": "0.1.19",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/machines/machine-metrics"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-invariants": "workspace:^"
  },
  "dependencies": {
    "@unieai/schemastery": "workspace:^",
    "@unieai/uad-subprocess": "workspace:^"
  },
  "devDependencies": {
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-subprocess": "workspace:^"
  },
  "scripts": {}
}
