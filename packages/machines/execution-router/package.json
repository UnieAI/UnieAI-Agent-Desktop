{
  "name": "@unieai/uad-execution-router",
  "description": "The execution world, routed to the machine a person is working on",
  "version": "0.1.18",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/machines/execution-router"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./fs": {
      "types": "./lib/types/fs.d.ts",
      "default": "./lib/fs.js"
    },
    "./subprocess": {
      "types": "./lib/types/subprocess.d.ts",
      "default": "./lib/subprocess.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/fs.js",
    "lib/subprocess.js",
    "lib/shared.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-invariants": "workspace:^"
  },
  "dependencies": {
    "@unieai/schemastery": "workspace:^",
    "@unieai/uad-fs": "workspace:^",
    "@unieai/uad-fs-local": "workspace:^",
    "@unieai/uad-fs-sandbox": "workspace:^",
    "@unieai/uad-fs-ssh": "workspace:^",
    "@unieai/uad-machines": "workspace:^",
    "@unieai/uad-sandbox": "workspace:^",
    "@unieai/uad-subprocess": "workspace:^",
    "@unieai/uad-subprocess-local": "workspace:^",
    "@unieai/uad-subprocess-ssh": "workspace:^"
  },
  "devDependencies": {
    "@unieai/cordis": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-sandbox-policy": "workspace:^",
    "@unieai/uad-settings-file": "workspace:^",
    "@unieai/uad-ssh": "workspace:^",
    "@unieai/uad-ssh-server": "workspace:^"
  },
  "scripts": {}
}
