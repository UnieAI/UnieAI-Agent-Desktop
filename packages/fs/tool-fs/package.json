{
  "name": "@unieai/uad-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the DeepSeek Harness filesystem seam (ctx.fs)",
  "version": "0.1.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@unieai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@unieai/uad-attachment": "workspace:^",
    "@unieai/uad-fs": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-llm": "workspace:^",
    "@unieai/uad-sandbox": "workspace:^",
    "@unieai/uad-sandbox-policy": "workspace:^",
    "@unieai/uad-session": "workspace:^",
    "@unieai/uad-system-prompt": "workspace:^",
    "@unieai/uad-tools": "workspace:^",
    "@unieai/uad-user-approval": "workspace:^",
    "@unieai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@unieai/uad-agent": "workspace:^",
    "@unieai/uad-agent-loop": "workspace:^",
    "@unieai/uad-agent-loop-testkit": "workspace:^",
    "@unieai/uad-attachment": "workspace:^",
    "@unieai/uad-fs": "workspace:^",
    "@unieai/uad-fs-local": "workspace:^",
    "@unieai/uad-fs-observation-policy": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-llm": "workspace:^",
    "@unieai/uad-llm-deepseek": "workspace:^",
    "@unieai/uad-sandbox": "workspace:^",
    "@unieai/uad-sandbox-policy": "workspace:^",
    "@unieai/uad-session": "workspace:^",
    "@unieai/uad-system-prompt": "workspace:^",
    "@unieai/uad-tools": "workspace:^",
    "@unieai/uad-user-approval": "workspace:^",
    "@unieai/cordis": "workspace:^"
  }
