{
  "name": "@unieai/uad-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnieAI/UnieAI-Agent-Desktop.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@unieai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-llm": "workspace:^",
    "@unieai/uad-output-retention": "workspace:^",
    "@unieai/uad-session": "workspace:^",
    "@unieai/uad-spill": "workspace:^",
    "@unieai/uad-subprocess": "workspace:^",
    "@unieai/uad-system-prompt": "workspace:^",
    "@unieai/uad-timeout": "workspace:^",
    "@unieai/uad-tools": "workspace:^",
    "@unieai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@unieai/uad-agent": "workspace:^",
    "@unieai/uad-subprocess": "workspace:^",
    "@unieai/uad-subprocess-local": "workspace:^",
    "@unieai/uad-invariants": "workspace:^",
    "@unieai/uad-llm": "workspace:^",
    "@unieai/uad-output-retention": "workspace:^",
    "@unieai/uad-session": "workspace:^",
    "@unieai/uad-spill": "workspace:^",
    "@unieai/uad-system-prompt": "workspace:^",
    "@unieai/uad-timeout": "workspace:^",
    "@unieai/uad-tools": "workspace:^",
    "@unieai/cordis": "workspace:^"
  }
}
